{
  "name": "cardly-telegram-mini-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "cross-env VITE_DEMO_MODE=true vite",
    "dev:api": "tsx watch server/dev.ts",
    "dev:full": "concurrently --kill-others-on-fail -n api,web \"npm:dev:api\" \"npm:dev\"",
    "dev:vercel": "vercel dev",
    "db:setup": "tsx scripts/setup-database.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "check:server-entry": "tsx scripts/check-server-entry.ts",
    "check:client-boundary": "tsx scripts/check-client-boundary.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run typecheck:server && npm run test:run && npm run build && npm run check:server-entry && npm run check:client-boundary",
    "vercel:build": "npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/blob": "^2.6.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vercel/node": "^5.9.5",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
